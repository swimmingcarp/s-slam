<?xml version="1.0"?>
<package format="3">
  <name>kiss_matcher_ros</name>
  <version>0.1.0</version>
  <description>
    KISS-Matcher loop-closure / global-registration backend for ROS 2
    (bundles the KISS-Matcher core library and the SLAM nodes).
  </description>
  <maintainer email="shapelim@mit.edu">Hyungtae Lim</maintainer>
  <maintainer email="ted97k@kaist.ac.kr">Daebeom Kim</maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rcutils</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>eigen</depend>
  <depend>libflann-dev</depend>
  <depend>liblz4-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
